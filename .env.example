# Puerto interno donde escucha Express (el que va en "Port" al configurar el dominio en Coolify)
PORT=4000

# Conexión a PostgreSQL — en Coolify, usa el nombre del servicio de la base de datos como host
DATABASE_URL=postgres://node_store:CAMBIA_ESTA_CLAVE@postgres:5432/node_store

# Conexión a Redis — usada para refresh tokens y rate limiting
REDIS_URL=redis://redis:6379

# Secreto para firmar los JWT de acceso — genera uno único con: openssl rand -hex 32
JWT_ACCESS_SECRET=CAMBIA_ESTO_ES_UN_EJEMPLO
JWT_REFRESH_SECRET=CAMBIA_ESTO_TAMBIEN_ES_UN_EJEMPLO

# Dominio del frontend, para configurar CORS correctamente y para armar los
# links de verificación de correo / restablecer contraseña
FRONTEND_ORIGIN=https://app.ricops.com

# Dominio público de esta misma API — se usa para armar los redirect_uri que
# se registran en Google Cloud Console y en developer.apple.com
API_ORIGIN=https://api.ricops.com

# "production" activa cookies "secure" (solo viajan por HTTPS)
NODE_ENV=production

# --- Correo saliente (verificación, recuperación de contraseña, notificaciones de envío) ---
# Si los dejas vacíos, los correos se imprimen en los logs en vez de enviarse —
# útil mientras pruebas, antes de conectar un proveedor real (ej. Brevo, Resend, tu propio SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Node Store <no-reply@ricops.com>

# --- Fase 02: login social (se completan más adelante) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Fase 05: pagos (se completan más adelante) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
